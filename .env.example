# Python service / development only. Generate a fresh local token; never commit .env.
AIFANYI_ENVIRONMENT=development
AIFANYI_DEV_AUTH=true
AIFANYI_DEV_TOKEN=
AIFANYI_DATABASE_URL=sqlite:///./data/aifanyi.db
AIFANYI_CHECKPOINT_URL=sqlite:///./data/checkpoints.db
AIFANYI_DISPATCH=database
AIFANYI_REDIS_URL=redis://localhost:6379/0

# Both services must provide /v1/models, /v1/chat/completions and /tokenize.
AIFANYI_HYMT_BASE_URL=http://hymt.internal:8000/v1
AIFANYI_HYMT_MODEL=hy-mt2-7b
AIFANYI_HYMT_REVISION=unverified
AIFANYI_HYMT_API_KEY=
AIFANYI_HYMT_CONCURRENCY=1
AIFANYI_QWEN_BASE_URL=http://qwen.internal:8000/v1
AIFANYI_QWEN_MODEL=
AIFANYI_QWEN_REVISION=unverified
AIFANYI_QWEN_PRECISION=existing-service-unverified
AIFANYI_QWEN_API_KEY=
AIFANYI_QWEN_MAX_MODEL_LEN=16384
AIFANYI_QWEN_MAX_OUTPUT_TOKENS=4096
AIFANYI_QWEN_THINKING=provider_default
AIFANYI_QWEN_THINKING_FIELD=chat_template_kwargs
AIFANYI_QWEN_CONCURRENCY=2
AIFANYI_MODEL_TIMEOUT=120
AIFANYI_SYNC_WAIT_SECONDS=60
AIFANYI_ALLOWED_MODEL_HOSTS=[]

# Production uses verified OIDC JWTs and registered principals, never DEV_AUTH.
AIFANYI_OIDC_ISSUER=
AIFANYI_OIDC_AUDIENCE=
AIFANYI_OIDC_JWKS_URL=
AIFANYI_BOOTSTRAP_OIDC_SUBJECT=

# A hostname and every resolved IP must be explicitly allowed before callback delivery.
AIFANYI_CALLBACK_ALLOWED_HOSTS=[]
AIFANYI_CALLBACK_ALLOWED_CIDRS=[]
# Define endpoint-specific AIFANYI_CALLBACK_<NAME> secrets in the deployment secret store.

# Used only by Docker Compose; replace with a random URL-safe password.
POSTGRES_PASSWORD=
